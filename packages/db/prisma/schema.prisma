// FROZEN Prisma schema for MaggyBox. Do not change shapes without updating
// the architect's spec first.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: pooled/runtime connection used by the generated Prisma client.
// DIRECT_URL:   direct (non-pooled) connection used by the Prisma CLI for
//               migrations (prisma migrate deploy). Pooled endpoints (e.g.
//               PgBouncer/transaction mode) do not support the migration
//               engine. If the database has no separate pooling endpoint,
//               set DIRECT_URL to the same value as DATABASE_URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  queued
  extracting
  transcribing
  generating_cylinder
  done
  failed
}

model Transcription {
  id             String    @id @default(cuid())
  youtubeUrl     String
  videoId        String
  title          String?
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  errorCode      String?
  errorMessage   String?
  midiKey        String?
  midiBytes      Int?
  stlKey         String?
  stlBytes       Int?
  cylinderSpecId String?
  durationSec    Int?
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([videoId])
}

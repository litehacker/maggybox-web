// FROZEN Prisma schema for MaggyBox. Do not change shapes without updating
// the architect's spec first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direct (non-pooling) connection used by the Prisma CLI for migrations.
  // Required whenever DATABASE_URL is a pooled connection string (e.g. Neon
  // via the Vercel storage link). For plain/unpooled Postgres, set DIRECT_URL
  // to the same value as DATABASE_URL. Runtime traffic never uses directUrl.
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  queued
  extracting
  transcribing
  generating_cylinder
  done
  failed
}

model Transcription {
  id             String    @id @default(cuid())
  youtubeUrl     String
  videoId        String
  title          String?
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  errorCode      String?
  errorMessage   String?
  midiKey        String?
  midiBytes      Int?
  stlKey         String?
  stlBytes       Int?
  cylinderSpecId String?
  durationSec    Int?
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([videoId])
}

// FROZEN Prisma schema for MaggyBox. Do not change shapes without updating
// the architect's spec first.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: pooled/runtime connection. On Railway, PgBouncer runs in
// session mode so prisma migrate deploy also works over this URL — no
// separate direct connection is needed. The runtime client in index.ts
// sets url explicitly and never reads directUrl.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum JobStatus {
  queued
  extracting
  transcribing
  generating_cylinder
  done
  failed
}

model Transcription {
  id             String    @id @default(cuid())
  youtubeUrl     String
  videoId        String
  title          String?
  status         JobStatus @default(queued)
  progress       Int       @default(0)
  errorCode      String?
  errorMessage   String?
  midiKey        String?
  midiBytes      Int?
  stlKey         String?
  stlBytes       Int?
  cylinderSpecId String?
  durationSec    Int?
  lockedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  @@index([status, createdAt])
  @@index([videoId])
}

# Database (set by devops, MAG-6)
# DATABASE_URL — pooled/runtime Postgres URL used by the Prisma client at runtime.
DATABASE_URL=postgresql://user:password@localhost:5432/maggybox
# DIRECT_URL — direct (non-pooled) Postgres URL used by the Prisma CLI for
# `prisma migrate deploy`. On Neon/Vercel Postgres this is the non-pooling URL
# (Neon links inject it as POSTGRES_URL_NON_POOLING). If the database has no
# separate pooling endpoint, set it to the same value as DATABASE_URL.
DIRECT_URL=postgresql://user:password@localhost:5432/maggybox

# Object storage — pick ONE (see packages/storage). Falls back to local disk.
# BLOB_READ_WRITE_TOKEN=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_URL_STYLE=path
# Railway object storage uses S3_URL_STYLE=virtual-host.

# Local-driver artifact store + HMAC secret for signed download URLs.
# Relative paths are resolved from the repo root (not apps/web or apps/worker).
LOCAL_STORAGE_DIR=./.data/artifacts
STORAGE_SIGNING_SECRET=change-me

# Worker
WORKER_POLL_INTERVAL_MS=2000
MAX_VIDEO_SECONDS=600
PYTHON_BIN=python3

# Public base URL of the web app (used to build absolute signed URLs)
APP_BASE_URL=http://localhost:3000

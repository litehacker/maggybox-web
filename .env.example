# Database (set by devops, MAG-6). On Vercel, DATABASE_URL is injected by
# linking a Neon / Prisma Postgres store to the project (Storage tab).
DATABASE_URL=postgresql://user:password@localhost:5432/maggybox

# Direct (non-pooling) URL used by the Prisma CLI for `migrate deploy`.
# Required when DATABASE_URL is pooled (Neon default); for unpooled Postgres
# set DIRECT_URL to the same value as DATABASE_URL. Runtime never reads it.
DIRECT_URL=postgresql://user:password@localhost:5432/maggybox

# Object storage — pick ONE (see packages/storage). Falls back to local disk.
# BLOB_READ_WRITE_TOKEN=
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Local-driver artifact store + HMAC secret for signed download URLs
LOCAL_STORAGE_DIR=./.data/artifacts
STORAGE_SIGNING_SECRET=change-me

# Worker
WORKER_POLL_INTERVAL_MS=2000
MAX_VIDEO_SECONDS=600
PYTHON_BIN=python3

# Public base URL of the web app (used to build absolute signed URLs)
APP_BASE_URL=http://localhost:3000

{
  "name": "maggybox-web",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace @maggybox/web",
    "dev:worker": "npm run dev --workspace @maggybox/worker",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.base.json"
  },
  "devDependencies": {
    "prisma": "^5.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
